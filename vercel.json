{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/trabajo/nextcaddy",
      "destination": "/proyecto/nextcaddy",
      "permanent": true
    },
    {
      "source": "/trabajo",
      "destination": "/proyecto/nextcaddy",
      "permanent": true
    },
    {
      "source": "/proyecto",
      "destination": "/proyecto/nextcaddy",
      "permanent": false
    }
  ]
}
